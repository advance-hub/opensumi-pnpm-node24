{
  "name": "@opensumi/core",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "license": "MIT",
  "workspaces": [
    "client",
    "packages/*",
    "server",
    "tools/dev-tool",
    "tools/playwright",
    "tools/cli-engine",
    "tools/electron"
  ],
  "scripts": {
    "add:browser": "tsx ./scripts/add-browser",
    "add:node": "tsx ./scripts/add-node",
    "audit:production": "pnpm audit --prod --audit-level=high --registry=https://registry.npmjs.org",
    "build": "pnpm run compile",
    "build:all": "pnpm run build:webview-prebuilt && pnpm run build && pnpm run build:worker-host && pnpm run build:ext-host && pnpm run build:watcher-host && pnpm run build:components && pnpm run build:monaco-worker && pnpm run build:server",
    "build:cli-engine": "pnpm --dir tools/cli-engine run build",
    "build:client": "pnpm --filter @opensumi/client run build",
    "build:client:full": "pnpm --filter @opensumi/client run build:full",
    "build:components": "pnpm --dir packages/components run build:dist",
    "build:components:lib": "pnpm --dir packages/components run build",
    "build:ext-host": "pnpm --dir packages/extension run build:ext-host",
    "build:server": "pnpm --filter @opensumi/server run build",
    "build:server:workspace-agent": "pnpm build:server && pnpm --dir server package:workspace-agent",
    "build:workspace-agent": "go build -C go/workspace-agent -trimpath -o bin/workspace-agent ./cmd/workspace-agent",
    "build:ws-gateway": "go build -C go/workspace-agent -trimpath -o bin/ws-gateway ./cmd/ws-gateway",
    "build:watcher-host": "pnpm --dir packages/file-service run build:watcher-host",
    "build:monaco-worker": "pnpm --dir packages/monaco run build:worker",
    "build:webview-prebuilt": "pnpm --filter @opensumi/ide-webview run bundle-webview",
    "build:worker-host": "cross-env NODE_OPTIONS=--max-old-space-size=512 pnpm --dir packages/extension run compile:worker",
    "bundle:lite": "cross-env NODE_OPTIONS=--max-old-space-size=1024 tsx ./scripts/start --script=bundle:lite",
    "bundle:preview": "cross-env NODE_OPTIONS=--max-old-space-size=1024 tsx ./scripts/start --script=bundle:preview",
    "capacity:workspace-agent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-workspace-agent-capacity.ts",
    "changelog": "tsx -P scripts/tsconfig.scripts.json scripts/changelog/index.ts",
    "changelog-old": "node scripts/changelog/index.js",
    "check:dep": "tsx ./scripts/depcheck",
    "check:versions": "tsx ./scripts/check-workspace-dependencies.ts",
    "ci": "pnpm run init && pnpm run test:cov",
    "clean": "rimraf --glob \"./{client,server,packages/*,tools/*}/{lib,dist,dist-node}\"",
    "compile": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=512 tsx ./scripts/build",
    "create": "tsx ./scripts/create",
    "download-extension": "cross-env DEBUG=InstallExtension node scripts/download.js",
    "dev": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts",
    "dev:ai": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --ai",
    "dev:collaboration": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --collaboration",
    "dev:full": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --ai --notebook",
    "dev:full:collaboration": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --ai --notebook --collaboration",
    "dev:source": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --source",
    "format": "pnpm run lint:fix && prettier \"**/*.{js,jsx,ts,tsx,html,css,less}\" --write",
    "init": "pnpm run clean && pnpm run build:all",
    "preinstall": "node scripts/preinstall.js && husky install",
    "iteration": "tsx -P scripts/tsconfig.scripts.json scripts/iteration-plan.ts",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=512 tsx ./scripts/lint.ts --quiet",
    "lint:all": "cross-env NODE_OPTIONS=--max-old-space-size=512 tsx ./scripts/lint.ts",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=512 tsx ./scripts/lint.ts --fix",
    "manifest": "tsx ./scripts/generate-manifest-json",
    "prepare:test": "pnpm run compile && pnpm run build:worker-host",
    "profile:browser-runtime": "tsx scripts/profile-browser-runtime.ts",
    "profile:go-file-rpc": "tsx scripts/profile-go-file-rpc.ts",
    "profile:ws-gateway": "tsx scripts/profile-ws-gateway.ts",
    "smoke:workspace-agent:product": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/workspace-agent-product-smoke.ts",
    "postinstall": "node scripts/ensure-node-pty-helper.js",
    "publish": "pnpm run build:all && tsx ./scripts/publish",
    "publish:next": "pnpm run publish --rollback --type=next",
    "publish:snapshot": "pnpm run publish --rollback --type=snapshot",
    "rebuild:node": "sumi rebuild",
    "setup:native": "pnpm run rebuild:node",
    "start": "pnpm run dev",
    "start:e2e": "pnpm run start:legacy --script=start:e2e",
    "start:electron": "cross-env NODE_OPTIONS=--max-old-space-size=768 NODE_ENV=development tsx ./scripts/start-electron",
    "start:legacy": "cross-env NODE_OPTIONS=--max-old-space-size=768 HOST=127.0.0.1 WS_PATH=ws://127.0.0.1:8000 NODE_ENV=development tsx ./scripts/start",
    "start:lite": "cross-env NODE_OPTIONS=--max-old-space-size=768 NODE_ENV=development tsx ./scripts/start --script=start:lite",
    "start:client": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --client-only",
    "start:pty-service": "cross-env NODE_OPTIONS=--max-old-space-size=256 KTLOG_SHOW_DEBUG=1 tsx packages/terminal-next/src/node/pty.proxy.remote.exec.ts",
    "start:remote": "cross-env NODE_OPTIONS=--max-old-space-size=768 NODE_ENV=development tsx ./scripts/start",
    "start:server": "node --max-old-space-size=256 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev.ts --server-only",
    "test": "pnpm run test:runtime-scripts && node scripts/run-jest.js",
    "test:cov": "pnpm run test:heap --coverage",
    "test:heap": "pnpm run test --logHeapUsage",
    "test:file-type-runtime": "tsx --test scripts/file-type-runtime.test.ts",
    "test:runtime-scripts": "tsx --test scripts/file-type-runtime.test.ts scripts/package-resource-path.test.ts",
    "test:module": "cross-env NODE_OPTIONS=--max-old-space-size=1024 tsx ./scripts/module-jest --runInBand",
    "test:ui": "tsx ./scripts/run-ui-tests",
    "test:ui-ci": "tsx ./scripts/run-ui-tests --ci=true",
    "test:ui-concurrent-smoke": "tsx ./scripts/run-ui-tests --concurrentSmoke=true",
    "test:ui-headful": "tsx ./scripts/run-ui-tests --headful=true",
    "test:ui-report": "tsx ./scripts/run-ui-tests --report=true",
    "test:workspace-agent": "go test -C go/workspace-agent ./...",
    "test:workspace-agent:linux": "sh go/workspace-agent/scripts/test-linux-container.sh",
    "typecheck:scripts": "cross-env NODE_OPTIONS=--max-old-space-size=512 tsc -p configs/ts/tsconfig.runtime-scripts.json",
    "update-disttag": "tsx ./scripts/dist-tag",
    "update-version": "tsx ./scripts/publish --versionOnly",
    "update:iconfont": "tsx ./scripts/download-iconfont.ts",
    "watch": "cross-env NODE_OPTIONS=--max-old-space-size=768 NODE_ENV=production tsx ./scripts/watch",
    "watch:ext-host": "pnpm --dir packages/extension run watch:ext-host",
    "watch:worker-host": "cross-env NODE_OPTIONS=--max-old-space-size=512 pnpm --dir packages/extension run watch:worker"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,html,css,less,json,yml}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --config configs/eslint/eslint.config.ts --fix --quiet"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.17.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@opensumi/ide-dev-tool": "workspace:*",
    "@opensumi/tree-sitter-wasm": "0.0.2",
    "@types/debug": "^4.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^7.1.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^16.2.14",
    "@types/lodash": "^4.14.202",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-is": "^18.2.4",
    "@types/temp": "^0.9.1",
    "@types/ws": "^8.5.10",
    "async-retry": "^1.3.1",
    "await-event": "^2.1.0",
    "chalk": "^4.1.2",
    "compressing": "^2.1.3",
    "cross-env": "^7.0.3",
    "debug": "^4.3.2",
    "depcheck": "^1.4.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^5.0.0",
    "fs-extra": "^11.2.0",
    "git-rev-sync": "^3.0.1",
    "glob": "^11.0.3",
    "globals": "17.11.0",
    "handlebars": "^4.7.3",
    "husky": "^7.0.4",
    "is-git-clean": "^1.1.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.4.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^3.0.3",
    "jiti": "2.7.0",
    "jsdom": "^20.0.0",
    "jsdom-worker": "^0.3.0",
    "lerna": "^8.0.2",
    "lint-staged": "^15.2.2",
    "lodash": "^4.17.21",
    "node-fetch": "^2.6.7",
    "node-gyp": "^12.4.0",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "offline-iconfont": "^1.2.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "semver": "^7.5.2",
    "simple-git": "^3.3.0",
    "temp": "^0.9.4",
    "tinybench": "^2.6.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vscode-uri": "3.0.2",
    "webpack": "^5.94.0",
    "webpack-manifest-plugin": "^5.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "volta": {
    "node": "24.16.0",
    "pnpm": "11.21.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "proseWrap": "never",
    "endOfLine": "lf"
  }
}
